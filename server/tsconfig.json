{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "strict": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules"],
    "include": ["src", "../common/src"]
}
